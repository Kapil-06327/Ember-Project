<ModalDialog
  @translucentOverlay={{true}}
  @clickOutsideToClose={{true}}
  @onClose={{@onClose}}
  @containerClass="bg-white p-6 md:p-8 rounded-xl max-w-2xl w-full shadow-xl relative animate-fade-in"
>
  <button
    class="absolute top-3 right-4 text-gray-500 hover:text-red-600 text-xl font-bold"
    type="button"
    {{on "click" @onClose}}
  >
    ×
  </button>

  {{yield}}
</ModalDialog>
