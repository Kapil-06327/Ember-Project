<div class="layout">
  {{#unless this.isLoginRoute}}
    <header class="topnav">
      <h1 class="app-title">📋 My Ember ToDo App</h1>
      <nav class="nav-links">
        <LinkTo @route="tasks" class="nav-link">🔔 Notifications</LinkTo>
        <LinkTo @route="tasks" class="nav-link">👤 My Profile</LinkTo>
        <button class="nav-link logout-btn" {{on "click" this.handleLogout}}>🚪 Logout</button>
      </nav>
    </header>

    <div class="main-layout">
      <aside class="sidenav">
        <LinkTo @route="index" class="side-link">🏠 Home</LinkTo>
        <LinkTo @route="tasks" class="side-link">📝 Tasks</LinkTo>
        <LinkTo @route="users" class="side-link">👤 Users</LinkTo>
        <LinkTo @route="projects" class="side-link">📁 Projects</LinkTo>
      </aside>

      <main class="content">
        {{yield}}
      </main>
    </div>
  {{else}}
    <main class="login-page">
      {{yield}}
    </main>
  {{/unless}}
</div>
