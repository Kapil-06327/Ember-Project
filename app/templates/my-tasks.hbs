<h2 class="flex justify-between items-center text-2xs font-semibold mb-4">
  🧾 My Tasks
  <button 
    class="text-white bg-blue-600 hover:bg-blue-700 font-bold py-1.5 px-4 rounded"
    {{on "click" this.toggleModal}}
  >
    ➕ Add My Task
  </button>
</h2>

<Shared::DataTable @columns={{array "id" "title" "description"}} @rows={{this.model}} />

{{#if this.isModalOpen}}
  <div class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50" {{on "click" this.toggleModal}}>
    <div 
      class="bg-white rounded-lg shadow-xl p-6 w-full max-w-lg relative"
      {{on "click" this.stopPropagation}}
    >
      <h3 class="text-xl font-semibold text-gray-800 mb-4">Add My Task</h3>

      <form {{on "submit" this.addTask}} class="flex flex-col gap-4">
        <input
          type="text"
          name="title"
          placeholder="Title"
          value={{this.taskForm.title}}
          class="border border-gray-300 rounded-md px-4 py-2 text-sm"
          {{on "input" this.updateField}}
        />

        <textarea
          name="description"
          placeholder="Description"
          value={{this.taskForm.description}}
          class="border border-gray-300 rounded-md px-4 py-2 text-sm"
          {{on "input" this.updateField}}
        ></textarea>

        <div class="flex flex-col sm:flex-row gap-4">
          <label class="flex-1 text-sm font-medium text-gray-700">
            Priority:
            <select
              name="priority"
              value={{this.taskForm.priority}}
              class="w-full mt-1 border border-gray-300 rounded-md px-3 py-2 text-sm"
              {{on "change" this.updateField}}
            >
              <option value="">-- Select --</option>
              <option value="Low">Low</option>
              <option value="Normal">Normal</option>
              <option value="High">High</option>
            </select>
          </label>

          <label class="flex-1 text-sm font-medium text-gray-700">
            Due Date:
            <input
              type="date"
              name="dueDate"
              value={{this.taskForm.dueDate}}
              class="w-full mt-1 border border-gray-300 rounded-md px-3 py-2 text-sm"
              {{on "input" this.updateField}}
            />
          </label>
        </div>

        <label class="inline-flex items-center mt-2 text-sm text-gray-600">
          <input
            type="checkbox"
            name="isCompleted"
            checked={{this.taskForm.isCompleted}}
            class="mr-2"
            {{on "change" this.updateField}}
          />
          Mark as Completed
        </label>

        <div class="flex justify-end gap-3 pt-4">
          <button
            type="submit"
            class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium"
          >
            Add
          </button>
          <button
            type="button"
            {{on "click" @onClose}}
            class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium"
          >
            Cancel
          </button>
        </div>
      </form>

    </div>
  </div>
{{/if}}
