<table class="min-w-full divide-y divide-gray-200 shadow-md rounded-lg overflow-hidden">
  <thead class="bg-gray-100">
    <tr>
      {{#each @columns as |col|}}
        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">
          {{col}}
        </th>
      {{/each}}
    </tr>
  </thead>
  <tbody class="bg-white divide-y divide-gray-200">
    {{#each this.paginatedData as |row|}}
      <tr class="hover:bg-gray-50">
        {{#each @columns as |col|}}
          <td class="px-6 py-4 text-sm text-gray-800">
            {{get row col}}
          </td>
        {{/each}}
      </tr>
    {{/each}}
  </tbody>
</table>

<div class="flex items-center justify-between mt-4">
  {{#if (gt this.totalPages 1)}}
    <button
      type="button"
      {{on "click" this.prevPage}}
      disabled={{eq this.currentPage 1}}
      class="px-4 py-2 rounded-md border border-gray-300 text-sm font-medium text-gray-600 bg-white hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      ⬅ Prev
    </button>

    <span class="text-sm text-gray-600">
      Page <strong>{{this.currentPage}}</strong> of <strong>{{this.totalPages}}</strong>
    </span>

    <button
      type="button"
      {{on "click" this.nextPage}}
      disabled={{eq this.currentPage this.totalPages}}
      class="px-4 py-2 rounded-md border border-gray-300 text-sm font-medium text-gray-600 bg-white hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Next ➡
    </button>
  {{/if}}
</div>
