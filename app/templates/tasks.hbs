<div class="todo-container">
  <h2>📝 ToDo List</h2>

  {{!-- ✅ Filter Buttons --}}
  <div class="filter-buttons">
    <button type="button" {{on "click" (fn (mut this.status) "all")}} disabled={{eq this.status "all"}}>All</button>
    <button type="button" {{on "click" (fn (mut this.status) "completed")}} disabled={{eq this.status "completed"}}>Completed</button>
    <button type="button" {{on "click" (fn (mut this.status) "pending")}} disabled={{eq this.status "pending"}}>Pending</button>
  </div>

  {{!-- ✅ Task List --}}
  <ul class="task-list">
    {{#each this.model as |task|}}
      <li class="task-item">
        <label class="task-label">
          <input type="checkbox" checked={{task.isCompleted}} class="task-checkbox" />
          <span class={{if task.isCompleted "task-title completed" "task-title"}}>{{task.title}}</span>
        </label>
      </li>
    {{/each}}
  </ul>

  {{!-- ✅ Pagination Controls --}}
  <div class="pagination">
    <button disabled={{eq this.page 1}} type="button" {{on "click" this.goToPrevPage}}>Prev</button>
<span>Page {{this.page}}</span>
<button type="button" {{on "click" this.goToNextPage}}>Next</button>
  </div>

  {{!-- ✅ New Task Form --}}
  <form class="task-form" {{on "submit" this.addTask}}>
    <input
      type="text"
      placeholder="Enter a new task..."
      class="task-input"
      {{on "input" this.updateNewTask}}
    />
    <button type="submit" class="task-button">Add Task</button>
  </form>
</div>
