<div class="layout">
  {{#if this.isLoginRoute}}
    <main class="login-page">
      {{yield}}
    </main>
  {{else}}
    <header class="topnav">
      <div class="topnav-left">
        <h1 class="app-title">📋 Daily Docket</h1>
      </div>
      <nav class="topnav-right">
        <LinkTo @route="tasks" class="nav-link">🔔 Notifications</LinkTo>
        <LinkTo @route="tasks" class="nav-link">👤 My Profile</LinkTo>
        <button class="nav-link logout-btn" type="button" {{on "click" this.handleLogout}}>🚪 Logout</button>
      </nav>
    </header>

    <div class="main-layout">
      <aside class="sidenav">
        <LinkTo @route="index" class="side-link">🏠 Dashboard</LinkTo>
        <LinkTo @route="tasks" class="side-link">📝 Tasks</LinkTo>
        <LinkTo @route="users" class="side-link">👤 Users</LinkTo>
        <LinkTo @route="projects" class="side-link">📁 Projects</LinkTo>
        {{!-- <hr> --}}
        <LinkTo @route="my-tasks" class="side-link">✅ My Tasks</LinkTo>
        <LinkTo @route="users" class="side-link">🎯 Assigned to Me</LinkTo>
        <LinkTo @route="users" class="side-link">✔️ Completed Tasks</LinkTo>
        {{!-- <hr> --}}
        <LinkTo @route="users" class="side-link">📊 Activity Logs</LinkTo>
        <LinkTo @route="users" class="side-link">📈 Reports</LinkTo>
        <LinkTo @route="users" class="side-link">🧑 Roles</LinkTo>
        {{!-- <hr> --}}
        <LinkTo @route="users" class="side-link">💬 Comments</LinkTo>
        <LinkTo @route="users" class="side-link">🔔 Notifications</LinkTo>
        <LinkTo @route="users" class="side-link">🧪 Beta Features</LinkTo>
        <LinkTo @route="users" class="side-link">🔗 Integrations</LinkTo>
        {{!-- <hr> --}}
        <LinkTo @route="users" class="side-link">📘 Help</LinkTo>
        <LinkTo @route="users" class="side-link">🔒 Security</LinkTo>
      </aside>

      <main class="content">
        {{yield}}
      </main>
    </div>
  {{/if}}
</div>
